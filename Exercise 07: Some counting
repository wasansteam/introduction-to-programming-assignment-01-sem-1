#Excercise 7:  Some Counting


for i in range(0, 51):               # Count 0 to 50
    print(i)

for i in range(50, -1, -1):         # Count 50 to 0
    print(i)

for i in range(30, 51):             # Count 30 to 50
    print(i)

for i in range(50, 9, -2):          # Count 50 to 10 by 2
    print(i)

for i in range(100, 201, 5):        # Count 100 to 200 by 5
    print(i)
